# Normalize to LF in the repository; check out native on Windows.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.vsct      text
*.xaml      text
*.resx      text
*.imagemanifest text
*.vsixmanifest  text
*.ps1       text
# cmd.exe mis-parses a batch file with bare LF endings: it splices lines and reports
# nonsense like "'m' is not recognized". They have to stay CRLF on disk.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.md        text
*.json      text
*.html      text
*.css       text
*.ts        text
*.tsx       text

*.png       binary
*.vsix      binary
