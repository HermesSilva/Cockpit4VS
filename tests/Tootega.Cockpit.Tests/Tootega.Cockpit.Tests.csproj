<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same framework as the extension: the code under test targets the VS shell. -->
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Tootega.Cockpit.Tests</AssemblyName>
    <RootNamespace>Tootega.Cockpit.Tests</RootNamespace>
    <!-- The extension only builds for x64/AnyCPU under a 64-bit devenv. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Lets the live CLI tests skip rather than fail on a machine without Claude Code. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <!-- The extension excludes System.Text.Json at runtime because devenv.exe.config binds
         it to the copy the IDE loads. Tests run outside devenv, so they need the real
         assembly on disk. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not referenced transitively on net472; the OTEL receiver tests post over real HTTP. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tootega.Cockpit\Tootega.Cockpit.csproj" />
  </ItemGroup>

</Project>
