<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <MinimumVisualStudioVersion>18.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{3323B130-9652-472C-927B-8E412EB39964}</ProjectGuid>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Tootega.Cockpit</RootNamespace>
    <AssemblyName>Tootega.Cockpit</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <LangVersion>latest</LangVersion>
    <DeployExtension Condition="'$(IsBuildingForLiveUnitTesting)' == 'true'">False</DeployExtension>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.8.739" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- Fully managed Hunspell: reads .aff/.dic directly, with no native binaries to ship
         per architecture. The VS Code original used a WASM build, which has no .NET analogue. -->
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <!-- Renders the vault's enrolment QR as inline SVG, so the secret never touches disk. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Compile against System.Text.Json but do not ship it: devenv.exe.config binds
         every version up to 10.0.0.4 to the copy the IDE already loads, so packaging our
         own would be dead weight at best and a split-assembly conflict at worst. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="CockpitPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Theme-aware icon set: the manifest and its XAML sources ship with the VSIX so the
       VS ImageService can resolve and recolor each moniker per theme. -->
  <ItemGroup>
    <Content Include="Resources\Cockpit.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Resource, not Content: the manifest resolves each icon through the
         /Tootega.Cockpit;Component/... pack URI, which reads them from the assembly. -->
    <Resource Include="Resources\Icons\*.xaml" />
    <Content Include="Resources\CockpitExtension.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Hunspell dictionaries, with their own licences. Loaded from disk on first use
         rather than embedded: the pt-BR pair alone is over 5 MB. -->
    <Content Include="Dictionaries\*.*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Only index.html is listed statically. The bundle is added by the BuildWebView target
    instead, because a glob is evaluated before any target runs: on a clean build the
    generated files do not exist yet, and the VSIX would silently ship a tool window that
    loads nothing.
  -->
  <ItemGroup>
    <Content Include="WebView\index.html">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />

  <!--
    Builds the React UI before the VSIX is packaged, so the bundle can never be stale
    relative to the sources it came from.

    It is skipped when node is unavailable rather than failing the build: a contributor
    working only on the C# side should not need a JavaScript toolchain, and the previous
    bundle is still on disk. It is an error only when there is no bundle at all, because
    then the extension would ship a tool window that loads nothing.
  -->
  <Target Name="BuildWebView" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <WebViewDir>$(MSBuildProjectDirectory)\..\..\webview</WebViewDir>
      <WebViewBundle>$(MSBuildProjectDirectory)\WebView\main.js</WebViewBundle>
    </PropertyGroup>

    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>

    <Exec Condition="'$(NodeExitCode)' == '0' AND !Exists('$(WebViewDir)\node_modules')"
          Command="npm install --no-audit --no-fund"
          WorkingDirectory="$(WebViewDir)" />

    <Exec Condition="'$(NodeExitCode)' == '0'"
          Command="node esbuild.mjs $(WebViewEsbuildArgs)"
          WorkingDirectory="$(WebViewDir)" />

    <Warning Condition="'$(NodeExitCode)' != '0' AND Exists('$(WebViewBundle)')"
             Text="node was not found; reusing the existing webview bundle." />

    <Error Condition="'$(NodeExitCode)' != '0' AND !Exists('$(WebViewBundle)')"
           Text="The webview bundle is missing and node is not available to build it. Install Node.js, or run 'npm run build' in the webview folder." />

    <!-- Added here, after the files exist. A static glob would have been evaluated before
         this target ran and would have packaged nothing on a clean build. -->
    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)\WebView\main.*">
        <IncludeInVSIX>true</IncludeInVSIX>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>WebView\%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WebViewEsbuildArgs>--production</WebViewEsbuildArgs>
  </PropertyGroup>
</Project>
