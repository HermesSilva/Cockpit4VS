<?xml version="1.0" encoding="utf-8"?>
<!-- UTF-8 hook: fixes garbled accents in PowerShell tool output on Windows. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Width="16" Height="16">
  <Canvas Width="16" Height="16">
    <Rectangle Width="16" Height="16" Fill="Transparent" />
    <Rectangle Canvas.Left="1.8" Canvas.Top="3" Width="12.4" Height="10" RadiusX="1.4" RadiusY="1.4"
               Stroke="#FF2B2B2B" StrokeThickness="1.3" />
    <Path Stroke="#FF2B2B2B" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Data="M 4.4 6.6 L 6.6 8.6 L 4.4 10.6" />
    <Path Stroke="#FFE8792B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Data="M 8.4 10.6 L 12 10.6" />
  </Canvas>
</Viewbox>
