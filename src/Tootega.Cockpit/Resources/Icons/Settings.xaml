<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: sliders read better than a cogwheel at 16px. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Width="16" Height="16">
  <Canvas Width="16" Height="16">
    <Rectangle Width="16" Height="16" Fill="Transparent" />
    <Path Stroke="#FF2B2B2B" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Data="M 2 5 L 14 5 M 2 11 L 14 11" />
    <Ellipse Canvas.Left="8.4" Canvas.Top="3.4" Width="3.2" Height="3.2" Fill="#FFE8792B" />
    <Ellipse Canvas.Left="4.4" Canvas.Top="9.4" Width="3.2" Height="3.2" Fill="#FFE8792B" />
  </Canvas>
</Viewbox>
