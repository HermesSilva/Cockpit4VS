<?xml version="1.0" encoding="utf-8"?>
<!-- Interrupt: stop the running turn. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Width="16" Height="16">
  <Canvas Width="16" Height="16">
    <Rectangle Width="16" Height="16" Fill="Transparent" />
    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12"
             Stroke="#FF2B2B2B" StrokeThickness="1.3" />
    <Rectangle Canvas.Left="5.75" Canvas.Top="5.75" Width="4.5" Height="4.5"
               RadiusX="0.9" RadiusY="0.9" Fill="#FFE8792B" />
  </Canvas>
</Viewbox>
