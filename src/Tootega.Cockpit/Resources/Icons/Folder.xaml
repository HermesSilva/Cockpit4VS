<?xml version="1.0" encoding="utf-8"?>
<!-- Folder: the conversation's scope. The tab on the orange accent is what separates it
     from the shell's own folder glyphs at a glance in a crowded toolbar. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Width="16" Height="16">
  <Canvas Width="16" Height="16">
    <Rectangle Width="16" Height="16" Fill="Transparent" />
    <!-- tab -->
    <Path Stroke="#FFE8792B" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          StrokeLineJoin="Round" Data="M 1.9,4.3 L 1.9,3.2 L 6.4,3.2 L 7.7,4.9" />
    <!-- body -->
    <Path Stroke="#FF2B2B2B" StrokeThickness="1.4" StrokeLineJoin="Round"
          Data="M 1.9,4.9 L 14.1,4.9 L 14.1,12.8 L 1.9,12.8 Z" />
  </Canvas>
</Viewbox>
