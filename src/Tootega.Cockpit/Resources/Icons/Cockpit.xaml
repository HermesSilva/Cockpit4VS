<?xml version="1.0" encoding="utf-8"?>
<!--
  The product mark, carried over from the VS Code extension (media/icon-color.svg there):
  a crown of eight flames around a ring, with "AI" inside it. Same geometry, same colours,
  on a 24-unit canvas scaled to the 16px grid — this is the icon users already associate
  with the Cockpit, and it should not change between the two editors.

  It is the one icon in the set that departs from the neutral-stroke-plus-orange rule in
  CLAUDE.md §5, because it is a logo rather than chrome. Colour inversion is turned off for
  it in Cockpit.imagemanifest for the same reason: a brand mark that changes hue with the
  theme is a different brand mark.
-->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Width="16" Height="16">
  <Canvas Width="24" Height="24">
    <Rectangle Width="24" Height="24" Fill="Transparent" />

    <!-- Crown of flames: one tongue, repeated every 45 degrees about the centre. -->
    <Canvas>
      <Canvas.Resources>
        <Geometry x:Key="Flame">M 12,0.4 C 14.1,3.4 13.9,4.9 12,6.3 C 10.1,4.9 9.9,3.4 12,0.4 Z</Geometry>
      </Canvas.Resources>

      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}" />
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="45" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="90" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="135" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="180" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="225" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="270" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
      <Path Fill="#FFFF7A18" Data="{StaticResource Flame}">
        <Path.RenderTransform><RotateTransform Angle="315" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
    </Canvas>

    <!-- Ring -->
    <Ellipse Canvas.Left="4.3" Canvas.Top="4.3" Width="15.4" Height="15.4"
             Stroke="#FFFF9A3C" StrokeThickness="1.7" />

    <!-- "AI", drawn rather than typeset, so it survives any scale and any font. -->
    <Path Stroke="#FF4DA3FF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          StrokeLineJoin="Round" Data="M 7.8,16.6 L 10.5,8.0 L 13.2,16.6" />
    <Path Stroke="#FF4DA3FF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Data="M 8.7,13.9 L 12.3,13.9" />
    <Path Stroke="#FF4DA3FF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Data="M 15.9,8.0 L 15.9,16.6" />
  </Canvas>
</Viewbox>
