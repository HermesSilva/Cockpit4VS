<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidCockpitPackage">

    <Menus>
      <!--
        One submenu under Extensions keeps the top-level menu bar clean; everything the
        Cockpit contributes lives under a single, findable entry.

        Parented to the Extensions menu itself, rather than to the IDG_VS_EXTENSIONS group
        it used to hang from. The group is still declared in vsshlids.h, but the two
        extensions on this machine that do get a menu bar entry both parent directly — one
        here, one on IDG_VS_MM_TOOLSADDINS, which the shell reparents under Extensions.
      -->
      <Menu guid="guidCockpitCmdSet" id="CockpitSubMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EXTENSIONS" />
        <Strings>
          <ButtonText>Tootega Cockpit</ButtonText>
          <CommandName>Tootega Cockpit</CommandName>
        </Strings>
      </Menu>

      <!-- Toolbar of the chat tool window: the actions you reach for mid-turn. -->
      <Menu guid="guidCockpitCmdSet" id="ChatToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>Cockpit</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidCockpitCmdSet" id="GroupSession" priority="0x0100">
        <Parent guid="guidCockpitCmdSet" id="CockpitSubMenu" />
      </Group>
      <Group guid="guidCockpitCmdSet" id="GroupAccount" priority="0x0200">
        <Parent guid="guidCockpitCmdSet" id="CockpitSubMenu" />
      </Group>
      <Group guid="guidCockpitCmdSet" id="GroupTools" priority="0x0300">
        <Parent guid="guidCockpitCmdSet" id="CockpitSubMenu" />
      </Group>

      <Group guid="guidCockpitCmdSet" id="ChatToolbarGroup" priority="0x0100">
        <Parent guid="guidCockpitCmdSet" id="ChatToolbar" />
      </Group>

      <!-- A group of its own, after the actions, so the folder sits to the right of them
           on the same row instead of being ordered among the buttons. -->
      <Group guid="guidCockpitCmdSet" id="ChatToolbarFolderGroup" priority="0x0200">
        <Parent guid="guidCockpitCmdSet" id="ChatToolbar" />
      </Group>

      <!-- View > Other Windows, where VS users expect tool windows to live. -->
      <Group guid="guidCockpitCmdSet" id="GroupOtherWindows" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
      </Group>

      <!--
        And directly under View, beside Solution Explorer and the other primary panels.
        Two entry points rather than one: Other Windows is a long list, and an extension
        nobody can find is an extension that does not work.
      -->
      <Group guid="guidCockpitCmdSet" id="GroupViewWindows" priority="0x0700">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWSEXPLORERS" />
      </Group>

      <!--
        Solution Explorer, on the solution and project nodes. A third entry point, and the
        one that does not depend on the shell reparenting a top-level menu: opening a
        conversation from the node you are working on is also the shortest path to the
        folder scoping the session.
      -->
      <Group guid="guidCockpitCmdSet" id="GroupSolutionContext" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
      </Group>
      <Group guid="guidCockpitCmdSet" id="GroupProjectContext" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidCockpitCmdSet" id="cmdidOpen" priority="0x0100" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Icon guid="guidCockpitImages" id="CockpitIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Open Cockpit</ButtonText>
          <CommandName>Tootega.Open</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidOpenHub" priority="0x0110" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Icon guid="guidCockpitImages" id="HubIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Open Cockpit Hub</ButtonText>
          <CommandName>Tootega.OpenHub</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidNewSession" priority="0x0120" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Icon guid="guidCockpitImages" id="NewSessionIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>New Session</ButtonText>
          <CommandName>Tootega.NewSession</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidInterrupt" priority="0x0130" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Icon guid="guidCockpitImages" id="InterruptIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Interrupt Agent</ButtonText>
          <CommandName>Tootega.Interrupt</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidOpenSessions" priority="0x0140" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Icon guid="guidCockpitImages" id="SessionsIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Saved Contexts</ButtonText>
          <CommandName>Tootega.OpenSessions</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidReopenClosed" priority="0x0150" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Strings>
          <ButtonText>Reopen Closed Session</ButtonText>
          <CommandName>Tootega.ReopenClosed</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidReloadView" priority="0x0160" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupSession" />
        <Icon guid="guidCockpitImages" id="ReloadIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Reload Cockpit View</ButtonText>
          <CommandName>Tootega.ReloadView</CommandName>
        </Strings>
      </Button>

      <!--
        The conversation's folder: shown as text beside its icon, and clicking it asks for
        another one. One control rather than a label plus a button, because a label the user
        cannot act on would only prompt the question "where do I change this?".

        TextChanges is what lets the handler rewrite the caption as the folder moves; without
        it the shell caches the first string it was given and never asks again.
      -->
      <Button guid="guidCockpitCmdSet" id="cmdidFolder" priority="0x0100" type="Button">
        <Parent guid="guidCockpitCmdSet" id="ChatToolbarFolderGroup" />
        <Icon guid="guidCockpitImages" id="FolderIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Folder</ButtonText>
          <CommandName>Tootega.Folder</CommandName>
          <ToolTipText>Change the folder this conversation runs in</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidLogin" priority="0x0100" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupAccount" />
        <Icon guid="guidCockpitImages" id="AccountIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Sign in to Claude (CLI)</ButtonText>
          <CommandName>Tootega.Login</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidLogout" priority="0x0110" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupAccount" />
        <Strings>
          <ButtonText>Sign out of Claude (CLI)</ButtonText>
          <CommandName>Tootega.Logout</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidSetApiKey" priority="0x0120" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupAccount" />
        <Icon guid="guidCockpitImages" id="ApiKeyIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Set Anthropic API Key</ButtonText>
          <CommandName>Tootega.SetApiKey</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidClearApiKey" priority="0x0130" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupAccount" />
        <Strings>
          <ButtonText>Clear Anthropic API Key</ButtonText>
          <CommandName>Tootega.ClearApiKey</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidEnableUsageTracking" priority="0x0100" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupTools" />
        <Icon guid="guidCockpitImages" id="UsageIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Enable Real Usage Tracking</ButtonText>
          <CommandName>Tootega.EnableUsageTracking</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidDisableUsageTracking" priority="0x0110" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupTools" />
        <Strings>
          <ButtonText>Disable Real Usage Tracking</ButtonText>
          <CommandName>Tootega.DisableUsageTracking</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidEnableUtf8Fix" priority="0x0120" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupTools" />
        <Icon guid="guidCockpitImages" id="Utf8FixIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Install PowerShell UTF-8 Fix</ButtonText>
          <CommandName>Tootega.EnableUtf8Fix</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidDisableUtf8Fix" priority="0x0130" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupTools" />
        <Strings>
          <ButtonText>Remove PowerShell UTF-8 Fix</ButtonText>
          <CommandName>Tootega.DisableUtf8Fix</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCockpitCmdSet" id="cmdidSettings" priority="0x0140" type="Button">
        <Parent guid="guidCockpitCmdSet" id="GroupTools" />
        <Icon guid="guidCockpitImages" id="SettingsIcon" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Cockpit Settings</ButtonText>
          <CommandName>Tootega.Settings</CommandName>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <!-- The toolbar and View > Other Windows reuse the same buttons; placement is what
       differs, so they are declared once above and re-parented here. -->
  <CommandPlacements>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidNewSession" priority="0x0100">
      <Parent guid="guidCockpitCmdSet" id="ChatToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidInterrupt" priority="0x0110">
      <Parent guid="guidCockpitCmdSet" id="ChatToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpenSessions" priority="0x0120">
      <Parent guid="guidCockpitCmdSet" id="ChatToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidReloadView" priority="0x0130">
      <Parent guid="guidCockpitCmdSet" id="ChatToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidSettings" priority="0x0140">
      <Parent guid="guidCockpitCmdSet" id="ChatToolbarGroup" />
    </CommandPlacement>

    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpen" priority="0x0100">
      <Parent guid="guidCockpitCmdSet" id="GroupOtherWindows" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpenHub" priority="0x0110">
      <Parent guid="guidCockpitCmdSet" id="GroupOtherWindows" />
    </CommandPlacement>

    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpen" priority="0x0100">
      <Parent guid="guidCockpitCmdSet" id="GroupViewWindows" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpenHub" priority="0x0110">
      <Parent guid="guidCockpitCmdSet" id="GroupViewWindows" />
    </CommandPlacement>

    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpen" priority="0x0100">
      <Parent guid="guidCockpitCmdSet" id="GroupSolutionContext" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpenHub" priority="0x0110">
      <Parent guid="guidCockpitCmdSet" id="GroupSolutionContext" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpen" priority="0x0100">
      <Parent guid="guidCockpitCmdSet" id="GroupProjectContext" />
    </CommandPlacement>
    <CommandPlacement guid="guidCockpitCmdSet" id="cmdidOpenHub" priority="0x0110">
      <Parent guid="guidCockpitCmdSet" id="GroupProjectContext" />
    </CommandPlacement>
  </CommandPlacements>

  <!-- Same shortcuts as the VS Code extension, so muscle memory carries over. -->
  <KeyBindings>
    <KeyBinding guid="guidCockpitCmdSet" id="cmdidOpen" editor="guidVSStd97"
                key1="C" mod1="Control Alt" />
    <KeyBinding guid="guidCockpitCmdSet" id="cmdidNewSession" editor="guidVSStd97"
                key1="N" mod1="Control Alt" />
    <KeyBinding guid="guidCockpitCmdSet" id="cmdidInterrupt" editor="guidVSStd97"
                key1="VK_OEM_PERIOD" mod1="Control Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidCockpitPackage" value="{92c17b2d-a9a9-460d-a1e2-d48f8f21e29f}" />

    <GuidSymbol name="guidCockpitCmdSet" value="{8b14bea4-9c47-451d-8143-63d452bc8422}">
      <IDSymbol name="CockpitSubMenu" value="0x1000" />
      <IDSymbol name="GroupSession" value="0x1020" />
      <IDSymbol name="GroupAccount" value="0x1021" />
      <IDSymbol name="GroupTools" value="0x1022" />
      <IDSymbol name="ChatToolbar" value="0x1030" />
      <IDSymbol name="ChatToolbarGroup" value="0x1031" />
      <IDSymbol name="ChatToolbarFolderGroup" value="0x1032" />
      <IDSymbol name="GroupOtherWindows" value="0x1040" />
      <IDSymbol name="GroupViewWindows" value="0x1041" />
      <IDSymbol name="GroupSolutionContext" value="0x1042" />
      <IDSymbol name="GroupProjectContext" value="0x1043" />

      <IDSymbol name="cmdidOpen" value="0x0100" />
      <IDSymbol name="cmdidNewSession" value="0x0101" />
      <IDSymbol name="cmdidInterrupt" value="0x0102" />
      <IDSymbol name="cmdidOpenSessions" value="0x0103" />
      <IDSymbol name="cmdidSettings" value="0x0104" />
      <IDSymbol name="cmdidReloadView" value="0x0105" />
      <IDSymbol name="cmdidReopenClosed" value="0x0106" />
      <IDSymbol name="cmdidLogin" value="0x0107" />
      <IDSymbol name="cmdidLogout" value="0x0108" />
      <IDSymbol name="cmdidSetApiKey" value="0x0109" />
      <IDSymbol name="cmdidClearApiKey" value="0x010A" />
      <IDSymbol name="cmdidEnableUsageTracking" value="0x010B" />
      <IDSymbol name="cmdidDisableUsageTracking" value="0x010C" />
      <IDSymbol name="cmdidEnableUtf8Fix" value="0x010D" />
      <IDSymbol name="cmdidDisableUtf8Fix" value="0x010E" />
      <IDSymbol name="cmdidOpenHub" value="0x010F" />
      <IDSymbol name="cmdidFolder" value="0x0110" />
    </GuidSymbol>

    <!-- Mirror of Resources/Cockpit.imagemanifest. -->
    <GuidSymbol name="guidCockpitImages" value="{092f81e8-c52d-446a-a584-57de6f62f2a1}">
      <IDSymbol name="CockpitIcon" value="1000" />
      <IDSymbol name="NewSessionIcon" value="1001" />
      <IDSymbol name="InterruptIcon" value="1002" />
      <IDSymbol name="SessionsIcon" value="1003" />
      <IDSymbol name="SettingsIcon" value="1004" />
      <IDSymbol name="ReloadIcon" value="1005" />
      <IDSymbol name="HubIcon" value="1006" />
      <IDSymbol name="AccountIcon" value="1007" />
      <IDSymbol name="ApiKeyIcon" value="1008" />
      <IDSymbol name="UsageIcon" value="1009" />
      <IDSymbol name="Utf8FixIcon" value="1010" />
      <IDSymbol name="FolderIcon" value="1011" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
