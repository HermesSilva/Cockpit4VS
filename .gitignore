# Build output
bin/
obj/
dist/
*.vsix
*.user
*.suo

# Visual Studio
.vs/

# Node (webview build)
node_modules/

# NuGet
packages/
*.nuget.props
*.nuget.targets

# Generated design-review artifact (scripts/preview-icons.ps1)
scripts/icon-preview.png

# Webview build output. Produced by webview/esbuild.mjs into the VSIX content folder;
# index.html beside it IS source and stays tracked.
src/Tootega.Cockpit/WebView/main.js
src/Tootega.Cockpit/WebView/main.css
src/Tootega.Cockpit/WebView/*.map

# Scratch output from inspecting the command tables: the compiled .vsct and the
# decompilation read back out of it. Both are throwaway copies of tracked source.
*-out.h
*-out.vsct
*.decompiled.h
*.decompiled.vsct

# Local run logs
temp/

# Plan-mode plans written by the extension (ExitPlanMode), one file per plan
Planing/
